{
  "name": "predictor",
  "version": "1.0.0",
  "description": "Aplicación web para analizar y predecir el consumo eléctrico mensual de un hogar.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon -e js,hbs,json src/index.js",
    "css": "tailwindcss -i src/input.css -o public/css/output.css",
    "css:watch": "tailwindcss -i src/input.css -o public/css/output.css --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "express": "^5.3.0",
    "hbs": "^4.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
